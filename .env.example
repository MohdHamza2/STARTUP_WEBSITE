# =============================================================================
# GENRA — environment variables
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored and MUST NEVER
# be committed (.claude/Claude.md §8, DOC5 §5.29).
#
# Only NEXT_PUBLIC_* values reach the browser. Everything else is server-only.
# The Supabase service-role key in particular must never be prefixed
# NEXT_PUBLIC_ — it bypasses Row Level Security entirely.
# =============================================================================

# --- Site --------------------------------------------------------------------
# TODO(business-facts): production domain, e.g. https://genra.com
# Leave unset until the real domain exists. Controls canonical URLs and sitemap.
NEXT_PUBLIC_SITE_URL=

# --- Supabase ----------------------------------------------------------------
# Project URL and anon key are safe to expose; RLS denies them all access to the
# lead tables by design. They are present for future client-side use only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Full database access, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Private storage bucket holding uploaded resumes. No public access.
SUPABASE_RESUME_BUCKET=resumes

# --- Resend (transactional email) --------------------------------------------
# SERVER ONLY.
RESEND_API_KEY=

# Verified sender on your Resend domain, e.g. "GENRA <noreply@genra.com>"
RESEND_FROM=

# Internal address that receives new-lead notifications.
# TODO(business-facts): the real internal inbox.
LEADS_NOTIFICATION_EMAIL=

# Send the candidate/client a confirmation email as well as notifying the team.
# DOC5 §5.24 makes this optional; defaults off until a sender domain is verified.
SEND_CONFIRMATION_EMAIL=false

# --- Cloudflare Turnstile (spam protection) ----------------------------------
# Site key is public by design; the secret is server-only and is what actually
# validates a submission (prompt §43 — a client token is never proof).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
